{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dxnexus.example/contracts/sdr/v1/live-command.schema.json",
  "title": "Ephemeral browser control messages",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "protocol", "commandId", "deviceId", "frequencyHz", "expectedFrequencyHz", "expectedSequence", "expiresAt"],
      "properties": {
        "type": { "const": "live.command.tune" },
        "protocol": { "const": "1.0" },
        "commandId": { "$ref": "common.schema.json#/$defs/uuid" },
        "deviceId": { "$ref": "common.schema.json#/$defs/uuid" },
        "frequencyHz": { "$ref": "common.schema.json#/$defs/frequencyHz" },
        "expectedFrequencyHz": { "$ref": "common.schema.json#/$defs/frequencyHz" },
        "expectedSequence": { "type": "integer", "minimum": 0 },
        "expiresAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
      }
    },
    {
      "type": "object",
      "required": ["type", "protocol", "commandId", "action", "success", "message"],
      "properties": {
        "type": { "const": "live.command.result" },
        "protocol": { "const": "1.0" },
        "commandId": { "$ref": "common.schema.json#/$defs/uuid" },
        "action": { "const": "tune" },
        "success": { "type": "boolean" },
        "message": { "type": "string", "maxLength": 300 },
        "frequencyHz": { "$ref": "common.schema.json#/$defs/frequencyHz" }
      }
    }
  ]
}
