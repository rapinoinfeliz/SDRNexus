{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dxnexus.example/contracts/sdr/v1/candidate-request.schema.json",
  "title": "Candidate context request",
  "type": "object",
  "required": ["protocol", "requestId", "sequence", "timestampUtc", "frequencyHz", "detector", "filterBandwidthHz", "receiver"],
  "properties": {
    "protocol": { "const": "1.0" },
    "requestId": { "$ref": "common.schema.json#/$defs/uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "timestampUtc": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "frequencyHz": { "$ref": "common.schema.json#/$defs/frequencyHz" },
    "band": { "type": "string", "enum": ["FM", "AM", "SW"] },
    "centerFrequencyHz": { "$ref": "common.schema.json#/$defs/frequencyHz" },
    "detector": { "$ref": "common.schema.json#/$defs/detector" },
    "filterBandwidthHz": { "$ref": "common.schema.json#/$defs/bandwidthHz" },
    "receiver": { "$ref": "common.schema.json#/$defs/receiverContext" },
    "measurements": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "common.schema.json#/$defs/measurement" }
    },
    "rds": {
      "type": "object",
      "properties": {
        "pi": { "type": "string", "pattern": "^[0-9A-Fa-f]{4}$" },
        "ps": { "type": "string", "maxLength": 32 },
        "rt": { "type": "string", "maxLength": 256 }
      }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
    "cursor": { "type": "string", "maxLength": 256 }
  }
}
